# Auth & organization layer — copy to .env.local and fill in.
# (.env* is git-ignored by this app's .gitignore.)

# --- Auth (server-only) ---
DATABASE_URL=postgres://vss_auth:vss_auth@localhost:5432/vss_auth
SESSION_SECRET=dev-only-change-me-to-a-random-32-plus-char-string
# ALLOW_SIGNUP=false          # uncomment to disable public sign-up

# --- SMTP (unset => OTP codes print to the server log) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# SMTP_FROM=you@example.com

# --- Upstream VSS APIs (server-only; used by the /api/gw proxy) ---
# AGENT_API_URL=http://localhost:8000/api/v1
# VST_API_URL=http://localhost:30888/vst/api
# ALERTS_API_URL=http://localhost:9081

# --- Browser-facing (repointed to the proxy in a later task) ---
# NEXT_PUBLIC_AGENT_API_URL_BASE=/api/gw/agent
# NEXT_PUBLIC_HTTP_CHAT_COMPLETION_URL=/api/gw/agent/chat/stream
# NEXT_PUBLIC_WEB_SOCKET_DEFAULT_ON=false
